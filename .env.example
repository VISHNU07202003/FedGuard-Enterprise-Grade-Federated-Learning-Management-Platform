# =============================================================================
# FedGuard Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fedguard:fedguard@postgres:5432/fedguard
POSTGRES_USER=fedguard
POSTGRES_PASSWORD=fedguard
POSTGRES_DB=fedguard

# -----------------------------------------------------------------------------
# Redis (added in later phases)
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=dev-secret-change-me-in-production

# -----------------------------------------------------------------------------
# MLflow (added in Phase 8)
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=

# -----------------------------------------------------------------------------
# Flower (added in Phase 5)
# -----------------------------------------------------------------------------
FLOWER_SERVER_ADDRESS=

# -----------------------------------------------------------------------------
# AWS Bedrock (added in Phase 12)
# -----------------------------------------------------------------------------
# Leave empty to use MockLLMClient (development mode).
# Set values to enable BedrockLLMClient (production/AWS mode).
AWS_REGION=
AWS_BEDROCK_MODEL_ID=
AWS_BEDROCK_GUARDRAIL_ID=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# Phase 8: MLflow Tracking
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=FedGuard
MLFLOW_ARTIFACT_ROOT=./mlruns
MLFLOW_ENABLE_REGISTRY=false
MLFLOW_STRICT_MODE=false
# ==========================================
# Deployment Settings (Phase 14)
# ==========================================
DEPLOYMENT_MODE=local
AWS_REGION=us-east-1

# Optional Integrations
USE_PARAMETER_STORE=false
PARAMETER_STORE_PREFIX=/fedguard/dev

USE_S3_ARTIFACT_STORE=false
S3_ARTIFACT_BUCKET=
S3_ARTIFACT_PREFIX=fedguard/artifacts

USE_CLOUDWATCH_LOGS=false
CLOUDWATCH_LOG_GROUP=/fedguard/backend

FRONTEND_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:5173
