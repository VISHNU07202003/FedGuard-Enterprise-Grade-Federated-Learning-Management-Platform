# FedGuard Frontend - Production Build Variables
# Copy to .env.production or set as CI/CD build-time env vars.
# All VITE_ vars are baked into the static bundle at build time.
# DO NOT include any backend secrets here.

# Required: The HTTPS URL of the FastAPI backend (no trailing slash)
VITE_API_URL=https://api.your-domain.com

# Optional: URLs for the observability dashboards
# If not set, the Observability page falls back to localhost defaults
VITE_GRAFANA_URL=https://grafana.your-domain.com
VITE_PROMETHEUS_URL=https://prometheus.your-domain.com
VITE_METRICS_URL=https://api.your-domain.com/metrics

# Disable mock data in production
VITE_USE_MOCK_DATA=false
